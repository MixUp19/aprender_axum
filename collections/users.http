@baseUrl = http://localhost:4000/api

@contentType = application/json
### read user
GET {{baseUrl}}/users/1
Content-Type: {{contentType}}

### read users paginated
GET {{baseUrl}}/users?page=0&page_size=10
Content-Type: {{contentType}}

### create user
POST  {{baseUrl}}/users
Content-Type:  {{contentType}}

{
    "username": "Ayala",
    "email": "",
    "fullName": "Lolita",
    "website": "",
    "age": 0,
    "password": "",
    "confirmPassword": ""
}
 
#### update user
PUT  {{baseUrl}}/users/1
Content-Type:  {{contentType}}

{
    "username": "xX_TheGamerPlayer_Xx",
    "fullName": "Osuna",
    "disabled": true
}

#### delete user
DELETE   {{baseUrl}}/users/5
Content-Type:  {{contentType}}

#### partial user update
PATCH  {{baseUrl}}/users/3
Content-Type:  {{contentType}}

{
    "username": "Maluma",
    "disabled": true
}
